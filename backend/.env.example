# Copy to .env for local development. Never commit .env.
# In production, Cloud Run injects these from Secret Manager.

# GCP
GCP_PROJECT_ID=ai-ops-center-eb26
GCP_REGION=us-central1

# Database (local dev: direct connection; production: Cloud SQL Auth Proxy URL)
DATABASE_URL=postgresql+asyncpg://ai_ops_user:YOUR_PASSWORD@localhost:5432/ai_ops

# Cloud SQL instance (used by Auth Proxy in production)
CLOUD_SQL_CONNECTION_NAME=ai-ops-center-eb26:us-central1:ai-ops-db

# Vertex AI — required to use ADC instead of a Gemini API key
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=ai-ops-center-eb26
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Investigation defaults
MAX_ITERATIONS=5
MAX_TOOL_CALLS=20
MAX_TOKENS=50000
CONFIDENCE_THRESHOLD=0.90

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
